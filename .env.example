# Copy to .env.local for local development. All values are read by the Node
# server process only (no NEXT_PUBLIC_ values).

# Default folder that the app lists on start (relative paths resolve from the
# project directory).
GALLERY_ROOT=./media

# Comma separated list of directories the app may read, thumbnail and delete
# inside. Defaults to GALLERY_ROOT only, which keeps the app safe by default.
# Example: GALLERY_ALLOWED_ROOTS=/data/photos,/mnt/nas/images
# GALLERY_ALLOWED_ROOTS=

# SQLite database file (created automatically, drizzle keeps the schema here).
GALLERY_DB_PATH=./data/gallery.db

# Where resized thumbnails are cached. Defaults to <db dir>/thumbs.
# GALLERY_CACHE_DIR=./data/thumbs

# Set to 1 to hide every delete action (useful for public kiosk deployments).
GALLERY_READ_ONLY=0

# Files above this size are served untouched instead of being resized.
# GALLERY_MAX_PREVIEW_BYTES=67108864
